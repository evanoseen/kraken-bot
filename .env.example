# Kraken Bot — environment template
#
# Copy this file to .env, fill in the secrets, and adjust the tunables
# to taste. The .env file is gitignored and must NEVER be committed.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Every variable below corresponds to one read in config.py. Defaults
# shown match config.py and are safe starting values.

# ─── Secrets ─────────────────────────────────────────────────────────
# Kraken REST API key (trade-enabled). Generate at
# https://www.kraken.com/u/security/api with Funds, Trade, and Query
# permissions. Rotate quarterly.
KRAKEN_API_KEY=your_kraken_api_key_here

# Kraken REST private key (paired with the API key above).
KRAKEN_PRIVATE_KEY=your_kraken_private_key_here

# Anthropic API key for Claude (claude-opus-4-6 via market_matcher.py).
# Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram alert when balance falls below this CAD value (Day 38).
# Leave blank to disable. Does not halt trading — notification only.
BALANCE_ALERT_THRESHOLD=20.0

# Telegram bot token + chat ID for trade alerts (Day 26).
# Create a bot via @BotFather, get the chat ID by messaging @userinfobot.
# Both must be set for alerts to fire; absent = alerts skipped silently.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Risk caps ───────────────────────────────────────────────────────
# Hard ceiling on CAD spent per single trade, before confidence scaling.
# Final size = min(MAX_TRADE_AMOUNT * confidence, balance * 0.25).
MAX_TRADE_AMOUNT=25.0

# Filter floor for news signals from Claude. Pump signals can dip below
# this (their formula floors at 0.65); only news is hard-filtered here.
MIN_CONFIDENCE=0.80

# Total CAD loss in a session that halts trading for the rest of the
# day. Resets on bot restart.
DAILY_LOSS_LIMIT=50.0

# Maximum drawdown from the session peak before the circuit breaker fires.
# 0.20 = halt if balance drops 20% below the highest point seen this session.
MAX_DRAWDOWN_PCT=0.20

# Maximum number of coins held simultaneously. Buys are skipped once this
# limit is reached; sells always go through.
MAX_OPEN_POSITIONS=3

# Maximum number of trades (buys + sells) per session before halting.
# Resets on bot restart. Prevents over-trading on noisy days.
MAX_TRADES_PER_DAY=10

# ─── Exit thresholds ─────────────────────────────────────────────────
# Per-position stop loss as a fraction. 0.10 means liquidate when down
# 10% from entry price.
STOP_LOSS_PCT=0.10

# Maximum hours to hold any position before force-selling, regardless of P&L.
# Prevents dead money from sitting in coins that never hit stop-loss or take-profit.
MAX_POSITION_AGE_HOURS=24

# Per-position take profit as a fraction. 0.25 means liquidate when up
# 25% from entry price.
TAKE_PROFIT_PCT=0.25

# ─── Cadence ─────────────────────────────────────────────────────────
# Minutes between trading cycles. Lower = more reactive but more API
# calls (watch Kraken rate limits).
RUN_INTERVAL_MINUTES=15

# Minutes a coin is blocked from trading after any trade executes on it.
# Prevents re-buying something just sold or piling back in on a faded signal.
TRADE_COOLDOWN_MINUTES=60

# ─── Master switch ───────────────────────────────────────────────────
# DRY_RUN=true logs every decision but places NO real orders. Set this
# to false ONLY after you have watched at least one full cycle in dry
# run mode and the logs look correct.
DRY_RUN=true
